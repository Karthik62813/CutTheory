# Copy this file to .env.local and fill in the two values (Supabase: click Connect, or Settings > API Keys).
# Both are safe for browsers. The app never uses a Supabase secret or service_role key. Do not add one.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
