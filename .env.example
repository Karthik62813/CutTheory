# Copy this file to .env.local and fill in the values, then restart npm run dev.

# Supabase (click Connect, or Settings > API Keys). Both are safe for browsers.
# The app never uses a Supabase secret or service_role key. Do not add one.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Cloudflare R2, for uploading videos and images from the admin. Optional: without these, projects take pasted links.
# These are server-only secrets. Never prefix them with NEXT_PUBLIC_.
# Account ID: R2 overview page. Keys: R2 > Manage API tokens > Create token, "Object Read & Write", limited to this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public address: its r2.dev URL or a custom domain, like https://media.yourdomain.com
R2_PUBLIC_URL=
